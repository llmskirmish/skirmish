{
  "name": "@skirmish/replay",
  "version": "0.1.0",
  "description": "Skirmish replay log format, types, and parsing utilities",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@skirmish/types": "workspace:*"
  },
  "devDependencies": {
    "@skirmish/typescript-config": "workspace:*",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist"
  ],
  "license": "MIT"
}

